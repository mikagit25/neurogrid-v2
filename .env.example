POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme_32chars_minimum_please
ENCRYPTION_KEY=changeme_32chars_for_aes256_key_
NEXT_PUBLIC_API_URL=http://localhost:4001
APP_URL=http://localhost:4001
FRONTEND_URL=http://localhost:3000

# LLM (OpenRouter или YandexGPT/GigaChat на старте)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Image generation — Together AI (FLUX, Ideogram, etc.)
IMAGE_PROVIDER=together
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/FLUX.1.1-pro

# Платёжный провайдер WebPay (Приорбанк)
# Получить после подписания договора с Приорбанком: https://www.priorbank.by/business/acquiring
# WEBPAY_STORE_ID — идентификатор магазина в системе WebPay (выдаёт банк)
# WEBPAY_SECRET_KEY — секретный ключ для подписи (выдаёт банк)
# WEBPAY_SANDBOX=true  — тестовый режим (securesandbox.webpay.by)
# WEBPAY_SANDBOX=false — боевой режим (payment.webpay.by)
# WEBPAY_CURRENCY — BYN (белорусский рубль) или RUB, USD, EUR по договору
WEBPAY_STORE_ID=
WEBPAY_SECRET_KEY=
WEBPAY_SANDBOX=true
WEBPAY_CURRENCY=BYN
