POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme_32chars_minimum_please
ENCRYPTION_KEY=changeme_32chars_for_aes256_key_
NEXT_PUBLIC_API_URL=http://localhost:4001
APP_URL=http://localhost:4001
FRONTEND_URL=http://localhost:3000

# =============================================================================
# LLM — Языковая модель
# =============================================================================
# БЕСПЛАТНЫЙ ВАРИАНТ (рекомендуется для старта):
#   Получить ключ бесплатно: https://aistudio.google.com → Get API key
#   Лимиты: 1500 запросов/день, 15 RPM, поддерживает vision (анализ фото)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_VISION_MODEL=gemini-2.0-flash

# АЛЬТЕРНАТИВА — OpenRouter (есть бесплатные модели с ключом):
#   https://openrouter.ai → Create Key
#   Бесплатные модели: google/gemini-flash-1.5-8b:free  meta-llama/llama-3.2-11b-vision-instruct:free
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-flash-1.5-8b:free
# LLM_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# АЛЬТЕРНАТИВА — Groq (очень быстрый, 14 400 req/day бесплатно):
#   https://console.groq.com
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-70b-versatile
# LLM_VISION_MODEL=llama-3.2-11b-vision-preview

# ПЛАТНЫЙ ВАРИАНТ (когда нужны высокие лимиты и лучшее качество):
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3-5-haiku
# LLM_VISION_MODEL=anthropic/claude-3-5-haiku

# =============================================================================
# Image generation — Генерация изображений
# =============================================================================
# БЕСПЛАТНЫЙ ВАРИАНТ (без ключа, Pollinations.ai — FLUX-based):
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=
IMAGE_MODEL=flux

# ПЛАТНЫЙ ВАРИАНТ (Together AI — FLUX.1.1-pro, лучшее качество):
#   https://api.together.ai
# IMAGE_PROVIDER=together
# IMAGE_API_KEY=
# IMAGE_MODEL=black-forest-labs/FLUX.1.1-pro

# =============================================================================
# Email (сброс пароля)
# =============================================================================
# Любой SMTP-провайдер. Примеры:
#   Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (нужен App Password)
#   Yandex:  SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465
#   Без настройки — ссылка пишется в лог сервера (для разработки)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@neurogrid.network

# =============================================================================
# Google OAuth — вход через Gmail
# =============================================================================
# 1. Откройте https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (тип: Web application)
# 3. Authorized redirect URIs: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# =============================================================================
# Платёжный провайдер WebPay (Приорбанк)
# =============================================================================
# Получить после подписания договора: https://www.priorbank.by/business/acquiring
WEBPAY_STORE_ID=
WEBPAY_SECRET_KEY=
WEBPAY_SANDBOX=true
WEBPAY_CURRENCY=BYN
